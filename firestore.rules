// =========================
// VIDEO CALL PROJECT RULES
// =========================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Users public ----------
    match /users_public/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Users private ----------
    match /users_private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Incoming calls (calleeId = documentId)
    match /incoming/{uid} {
      // only recipient can read
      allow read: if request.auth != null && request.auth.uid == uid;

      // caller creates the incoming doc → allow all auth users to write
      allow write: if request.auth != null;
    }

    // Calls main collection
    match /calls/{callId} {

      // anyone authenticated may create a call 
      allow create: if request.auth != null;

      // read/update allowed only to participants
      allow read, update: if request.auth != null
        && (
          resource.data.callerId == request.auth.uid ||
          resource.data.calleeId == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
