// ===============================
// FIRESTORE RULES — CALLS MVP
// ===============================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------
    // USERS PUBLIC
    // ----------------------------
    match /users_public/{userId} {
      allow read: if true;                      // всі можуть читати
      allow write: if request.auth != null 
                   && request.auth.uid == userId;
    }

    // ----------------------------
    // CALLS (відеодзвінки)
    // ----------------------------
    match /calls/{callId} {

      // READ:
      // caller, callee, або авторизований
      allow read: if request.auth != null
                  && (
                       request.auth.uid == resource.data.callerId ||
                       request.auth.uid == resource.data.calleeId
                     );

      // CREATE:
      // тільки авторизований caller
      allow create: if request.auth != null
                    && request.resource.data.callerId == request.auth.uid
                    && request.resource.data.calleeId is string
                    && request.resource.data.status == "ringing";

      // UPDATE:
      // Дозволити змінювати статус та roomId
      allow update: if request.auth != null
                    && (
                       // Caller може оновити дзвінок (наприклад end)
                       request.auth.uid == resource.data.callerId ||

                       // Callee може прийняти дзвінок
                       request.auth.uid == resource.data.calleeId
                    )
                    &&
                    // Поля які можна змінювати
                    request.resource.data.diff(resource.data).changedKeys()
                       .hasOnly([
                         "status",
                         "roomId",
                         "updatedAt"
                       ]);

      // DELETE — нікому
      allow delete: if false;
    }

    // ---------- Users private ----------
    match /users_private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Incoming calls (calleeId = documentId)
    match /incoming/{uid} {
      // only recipient can read
      allow read: if request.auth != null && request.auth.uid == uid;

      // caller creates the incoming doc → allow all auth users to write
      allow write: if request.auth != null;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}