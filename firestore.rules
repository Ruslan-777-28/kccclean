rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- PUBLIC PROFILES ---
    match /users_public/{userId} {
      // Anyone can get a specific user profile if they know the UID
      allow get: if true;
      // Only signed-in users can list all users (e.g., for the home page)
      allow list: if request.auth != null;

      // Only the authenticated owner can write to their public profile
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // --- PRIVATE PROFILES ---
    match /users_private/{userId} {
      // Only the owner can read/write
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // --- CALLS COLLECTION ---
    match /calls/{callId} {
      // Any authenticated user can create a call
      allow create: if request.auth != null;

      // The caller and callee can read the call document
      allow read: if request.auth != null 
                  && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      // The caller and callee can update the call status
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
                    && (request.resource.data.status in ["ringing", "accepted", "ended", "declined"]);
    }
  }
}
