rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Users public ----------
    match /users_public/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Users private ----------
    match /users_private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Incoming calls ----------
    match /incoming/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null;
    }

    // ---------- Calls ----------
    match /calls/{callId} {

      // Створити дзвінок — дозволено всім авторизованим
      allow create: if request.auth != null;

      // Читати / оновлювати можуть ТІЛЬКИ учасники дзвінка
      allow read, update: if request.auth != null
        && (
          request.auth.uid == resource.data.callerId ||
          request.auth.uid == resource.data.calleeId
        );

      // Видалити — дозволяємо тимчасово для MVP
      allow delete: if request.auth != null;
    }

    // ---------- fallback (забороняє все інше) ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
